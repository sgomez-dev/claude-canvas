exports[`diff canvas renders a multi-file diff 1`] = `
"\x1B[36m╭──────────────────────────────────────────────────────────────────────────────╮\x1B[39m
\x1B[36m│\x1B[39m \x1B[1mReview\x1B[22m                                                                       \x1B[36m│\x1B[39m
\x1B[36m│\x1B[39m \x1B[36m> a.txt (modified) 0/1 decided\x1B[39m                                               \x1B[36m│\x1B[39m
\x1B[36m│\x1B[39m   b.txt (modified) 0/1 decided                                               \x1B[36m│\x1B[39m
\x1B[36m╰──────────────────────────────────────────────────────────────────────────────╯\x1B[39m

╭──────────────────────────────────────────────────────────────────────────────╮
│ \x1B[2m@@ -1,2 +1,2 @@\x1B[22m                                                              │
│ \x1B[31m-old a\x1B[39m                                                                       │
│ \x1B[32m+new a\x1B[39m                                                                       │
│  shared                                                                      │
│ \x1B[1m\x1B[33m[undecided]\x1B[39m\x1B[22m                                                                  │
╰──────────────────────────────────────────────────────────────────────────────╯

\x1B[2ma/r: approve/reject  ↑/↓: hunk  PgUp/PgDn: scroll  Enter: submit  Esc: cancel\x1B[22m"
`;

